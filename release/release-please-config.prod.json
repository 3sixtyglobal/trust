		},
		"packages/trust-generators": {
			"package-name": "trust-generators",
			"changelog-path": "docs/changelog.md"
		},
		"packages/trust-verifiers": {
			"package-name": "trust-verifiers",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
